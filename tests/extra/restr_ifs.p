program restr_ifs;

var
	a: integer;
begin
	a := 1;
	if a = 0 then begin
		writeln(0);
	end;
	if a = 1 then begin
		writeln(1);
	end;
	if a = 2 then begin
		writeln(2);
	end;
	if a = 3 then begin
		writeln(3);
	end;
	if a = 4 then begin
		writeln(4);
	end;
	if a = 5 then begin
		writeln(5);
	end;
	if a = 6 then begin
		writeln(6);
	end;
end.
